{
    "multipart": [
        { "apply": { "model": "trafficcontrol:block/crossing_gate_pole" } },
        { "when": { "north": "true" }, "apply": { "model": "trafficcontrol:block/crossing_gate_pole_ext" } },
        { "when": { "south": "true" }, "apply": { "model": "trafficcontrol:block/crossing_gate_pole_ext", "y": 180 } },
        { "when": { "east": "true" }, "apply": { "model": "trafficcontrol:block/crossing_gate_pole_ext", "y": 90 } },
        { "when": { "west": "true" }, "apply": { "model": "trafficcontrol:block/crossing_gate_pole_ext", "y": 270 } }
    ]
}
